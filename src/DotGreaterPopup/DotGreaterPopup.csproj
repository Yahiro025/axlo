<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- WinExe: Program.cs (Task 5) provides the Main entry point, so this
         builds as a windowed exe with no console window. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DotGreaterPopup</AssemblyName>
    <RootNamespace>DotGreaterPopup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- axlo dot-o mark (docs/design/axlo-mark.svg master). -->
    <ApplicationIcon>axlo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets net48 build on machines with only the .NET SDK installed
         (no Framework targeting pack needed). Build-only, never flows. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

</Project>
